 "sentences": [
  {
   "en": "Last weekend, I took a train to Kyoto with my sister.",
   "ja": "先週末、妹と電車で京都へ行きました。",
   "chunkIds": [
    "c1",
    "c2",
    "c3"
   ]
  },
  {
   "en": "We wanted to visit some old temples before it got crowded.",
   "ja": "混雑する前に古いお寺をいくつか訪れたかったのです。",
   "chunkIds": [
    "c4",
    "c5",
    "c6"
   ]
  },
  {
   "en": "So we got up early and arrived at the first temple at eight.",
   "ja": "そこで早起きして、8時に最初のお寺に着きました。",
   "chunkIds": [
    "c7",
    "c8",
    "c9"
   ]
  },
  {
   "en": "It was quiet, and the morning air felt really fresh.",
   "ja": "静かで、朝の空気がとても新鮮に感じられました。",
   "chunkIds": [
    "c10",
    "c11",
    "c12"
   ]
  },
  {
   "en": "In the afternoon, we tried green tea sweets at a small shop.",
   "ja": "午後は小さなお店で抹茶のお菓子を食べてみました。",
   "chunkIds": [
    "c13",
    "c14",
    "c15"
   ]
  },
  {
   "en": "It was a short trip, but I want to go back in autumn.",
   "ja": "短い旅行でしたが、秋にまた行きたいです。",
   "chunkIds": [
    "c16",
    "c17",
    "c18"
   ]
